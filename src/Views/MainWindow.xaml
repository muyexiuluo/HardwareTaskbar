<!-- 由 大龙虾 于 2026-09-04 创建，用于 HardwareTaskbar 主悬浮窗。
     2026-09-04 恢复旧版款式（老大要求）：完全透明（无黑块）、双行五列、微软雅黑，
     文本/颜色语义照抄 scripts/taskbar_monitor_v13.cpp。
     2026-09-04 第二次调整（老大要求"列间距太大，按各自数据缩小"）：
       - 值列固定宽度按微软雅黑 13px 实测最大值 + 8px 余量收紧（不再拍脑袋 96/98/118）。2026-09-07 第三次收紧（老大要求"间距再缩一个汉字宽"）：值列固定宽度全部移除，宽度 = 当前文本实测，不留尾部空白（网速列不再留 2 字符空位）。
       - 列间距 18 → 10，值前距 6 → 5。
       实测最大值：显存 77 / 温度 37 / 利用率 35 / CPU 35 / CPU温度 37 / 网速 62。
       整窗从 ~739px 收到 ~580px，数据变化仍只改列内文本不改布局（防跳动语义保留）。 -->
<Window x:Class="HardwareTaskbar.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HardwareTaskbar"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        Focusable="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        SizeToContent="WidthAndHeight">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <!-- 旧版标签色 RGB(130,135,150)；FontSize 绑定 VM -->
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Microsoft YaHei"/>
            <Setter Property="FontSize" Value="{Binding FontSize}"/>
            <Setter Property="Foreground" Value="#828796"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <!-- 旧版值默认白；彩色值在实例上绑定 Foreground 覆盖。
             值前距 5（2026-09-04 由 6 收紧，配合列间距收窄） -->
        <Style x:Key="Value" TargetType="TextBlock" BasedOn="{StaticResource Label}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="5,0,0,0"/>
        </Style>
    </Window.Resources>
    <Grid Margin="14,3" VerticalAlignment="Center">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 行 1：GPU0 + CPU + 下载 -->
        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="0,0,6,0"
                    Visibility="{Binding ShowGpu0, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="显卡: 1" Style="{StaticResource Label}"/>
            <TextBlock Text="{Binding TopGpuValue}" Style="{StaticResource Value}"/>
        </StackPanel>
        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,0,6,0"
                    Visibility="{Binding ShowGpu0, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="温度:" Style="{StaticResource Label}"/>
            <TextBlock Text="{Binding TopTempValue}" Style="{StaticResource Value}"
                       Foreground="{Binding TopTempColor}"/>
        </StackPanel>
        <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" Margin="0,0,6,0"
                    Visibility="{Binding ShowGpu0, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="利用率:" Style="{StaticResource Label}"/>
            <TextBlock Text="{Binding TopUtilValue}" Style="{StaticResource Value}"/>
        </StackPanel>
        <StackPanel Grid.Row="0" Grid.Column="3" Orientation="Horizontal" Margin="0,0,6,0"
                    Visibility="{Binding ShowCpu, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="CPU:" Style="{StaticResource Label}"/>
            <TextBlock Text="{Binding TopCpuValue}" Style="{StaticResource Value}"/>
        </StackPanel>
        <StackPanel Grid.Row="0" Grid.Column="4" Orientation="Horizontal"
                    Visibility="{Binding ShowNetwork, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="下载:" Style="{StaticResource Label}"/>
            <TextBlock Text="{Binding TopDownValue}" Style="{StaticResource Value}"
                       Foreground="{Binding TopDownColor}"/>
        </StackPanel>

        <!-- 行 2：GPU1 + CPU温度 + 上传 -->
        <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Margin="0,0,6,0"
                    Visibility="{Binding ShowGpu1, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="显卡: 2" Style="{StaticResource Label}"/>
            <TextBlock Text="{Binding BotGpuValue}" Style="{StaticResource Value}"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,0,6,0"
                    Visibility="{Binding ShowGpu1, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="温度:" Style="{StaticResource Label}"/>
            <TextBlock Text="{Binding BotTempValue}" Style="{StaticResource Value}"
                       Foreground="{Binding BotTempColor}"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" Margin="0,0,6,0"
                    Visibility="{Binding ShowGpu1, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="利用率:" Style="{StaticResource Label}"/>
            <TextBlock Text="{Binding BotUtilValue}" Style="{StaticResource Value}"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Grid.Column="3" Orientation="Horizontal" Margin="0,0,6,0"
                    Visibility="{Binding ShowCpu, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="CPU温度:" Style="{StaticResource Label}"/>
            <TextBlock Text="{Binding BotCpuTempValue}" Style="{StaticResource Value}"
                       Foreground="{Binding BotCpuTempColor}"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Grid.Column="4" Orientation="Horizontal"
                    Visibility="{Binding ShowNetwork, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="上传:" Style="{StaticResource Label}"/>
            <TextBlock Text="{Binding BotUpValue}" Style="{StaticResource Value}"
                       Foreground="{Binding BotUpColor}"/>
            <!-- 网速列不再额外留 2 字符空位（2026-09-04 老大要求按数据收紧，防跳动靠固定宽度已足够） -->
        </StackPanel>
    </Grid>
</Window>
