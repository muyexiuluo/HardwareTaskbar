<!-- 由 大龙虾 于 2026-09-04 创建，用于 HardwareTaskbar 第五阶段：设置窗口 -->
<Window x:Class="HardwareTaskbar.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="硬件任务栏监控 - 设置"
        Width="360" Height="360"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="True">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="刷新间隔（毫秒，最低 500）" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <TextBox  Grid.Row="1" x:Name="TxtRefresh" Margin="0,0,0,12" Padding="4"/>

        <TextBlock Grid.Row="2" Text="显示项" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,12">
            <CheckBox x:Name="ChkGpu0" Content="GPU0" IsChecked="True" Margin="0,0,16,0"/>
            <CheckBox x:Name="ChkGpu1" Content="GPU1" IsChecked="True" Margin="0,0,16,0"/>
            <CheckBox x:Name="ChkCpu" Content="CPU" IsChecked="True" Margin="0,0,16,0"/>
            <CheckBox x:Name="ChkNet" Content="网络" IsChecked="True"/>
        </StackPanel>

        <TextBlock Grid.Row="4" Text="字体大小（10-24）" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <Slider   Grid.Row="5" x:Name="SldFont" Minimum="10" Maximum="24" Value="13"
                  IsSnapToTickEnabled="True" TickFrequency="1"
                  HorizontalAlignment="Left" Width="280" Margin="0,0,0,12"
                  VerticalAlignment="Top"/>

        <!-- 2026-09-13 老大要求：开机自启改成复选框，点「应用」才生效 -->
        <CheckBox Grid.Row="6" x:Name="ChkAutostart" Content="开机自启" Margin="0,0,0,12"
                  HorizontalAlignment="Left" VerticalAlignment="Center"/>

        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
            <Button x:Name="BtnApply" Content="应用" Width="80" Height="28" Margin="0,0,8,0"
                    Click="BtnApply_Click"/>
            <Button x:Name="BtnClose" Content="关闭" Width="80" Height="28"
                    Click="BtnClose_Click"/>
        </StackPanel>
    </Grid>
</Window>
